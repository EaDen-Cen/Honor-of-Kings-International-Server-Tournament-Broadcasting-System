{
  "name": "vite-project",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "server": "node --env-file-if-exists=.env --import tsx server/server.ts",
    "test": "node --import tsx --test server/*.test.ts scripts/hero-sync/*.test.ts",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "preview": "vite preview",
    "hero:check": "tsx scripts/hero-sync/sync.ts --check",
    "hero:art-audit": "tsx scripts/hero-sync/auditArt.ts",
    "hero:crop-sync": "node --env-file-if-exists=.env --import tsx scripts/hero-sync/syncArtFocus.ts",
    "hero:sync": "tsx scripts/hero-sync/sync.ts --update",
    "hero:validate": "tsx scripts/hero-sync/validate.ts",
    "simulator": "vite --open /tools/bp-simulator-control",
    "simulator:server": "vite --host 127.0.0.1 --strictPort",
    "simulator:stage": "vite --open /tools/bp-simulator",
    "benchmark:recognition": "node --import tsx scripts/benchmark-recognition.ts",
    "recovery": "node --env-file-if-exists=.env --import tsx scripts/recovery.ts",
    "benchmark:players": "node --import tsx scripts/benchmark-player-recognition.ts",
    "hero:cn-sync": "tsx scripts/hero-sync/syncCn.ts",
    "hero:art-cache": "tsx scripts/cache-broadcast-art.ts",
    "format": "node scripts/format-core.mjs --write",
    "format:check": "node scripts/format-core.mjs --check",
    "benchmark:hud": "node --import tsx scripts/benchmark-hud-recognition.ts"
  },
  "dependencies": {
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.13",
    "globals": "^15.11.0",
    "postcss": "^8.4.47",
    "prettier": "^3.6.2",
    "tsx": "^4.19.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.4"
  }
}
